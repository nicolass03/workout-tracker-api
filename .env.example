DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
SUPABASE_URL=https://[PROJECT-REF].supabase.co

# Client apps use the publishable key (sb_publishable_...), not the legacy anon JWT key.
# The API does not need that key — it verifies user access tokens via JWKS (or JWT secret below).
# Dashboard → Settings → API Keys → Publishable key

# Required only for legacy HS256 projects (JWT Settings → JWT Secret)
# SUPABASE_JWT_SECRET=
