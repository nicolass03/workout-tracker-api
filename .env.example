DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
SUPABASE_URL=https://[PROJECT-REF].supabase.co
# Optional. Use a private Redis URL; the API remains fully functional without it.
# REDIS_URL=redis://default:[PASSWORD]@[PRIVATE-HOST]:6379

# Client apps use the publishable key (sb_publishable_...), not the legacy anon JWT key.
# The API does not need that key — it verifies user access tokens via JWKS (or JWT secret below).
# Dashboard → Settings → API Keys → Publishable key

# Required only for legacy HS256 projects (JWT Settings → JWT Secret)
# SUPABASE_JWT_SECRET=
# Used only by scripts/upload_opengym_media.py; never expose this to the app/API.
# SUPABASE_SERVICE_ROLE_KEY=
# Public bucket containing OpenGym media. Defaults to opengym-media.
# MEDIA_BUCKET=your-public-media-bucket
# Optional override for a CDN or Supabase Storage public bucket.
# MEDIA_BASE_URL=https://[PROJECT-REF].supabase.co/storage/v1/object/public/[BUCKET]
